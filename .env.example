# ─────────────────────────────────────────────────────────────────────────────
# 9.11 Frontend (VITE_ — BUILD-TIME, NEVER SECRET)
# ─────────────────────────────────────────────────────────────────────────────
#
# VITE_MAP_TILE_URL and VITE_MAP_ATTRIBUTION are DELETED. The backend is the single
# source of truth for provider config — the SPA calls GET /imagery/providers. An
# escape hatch that lets the bundle disagree with the server about which provider's
# ToS applies is exactly the kind of divergence this system cannot afford.
#
# These are baked into the JS bundle at BUILD time. Anything secret put here is
# public. Changing one requires rebuilding the frontend image, not restarting it.
#

#   src/api/client.ts
# VITE_API_BASE_URL=/api/v1

#   shell/TopBar
# VITE_APP_NAME=LandExplorer

#   store/mapStore
# VITE_MAP_DEFAULT_CENTER=0,0

#   store/mapStore
# VITE_MAP_DEFAULT_ZOOM=3

#   api/hooks/useJob — floor for the adaptive schedule
# VITE_JOB_POLL_INTERVAL_MS=1500

#   upload/UploadDropzone — mirrors LE_UPLOAD_MAX_BYTES
# VITE_MAX_UPLOAD_MB=500

#   main.tsx
# VITE_ENABLE_DEVTOOLS=false

#   annotation/AnnotationToolbar — a homography needs >= 4
# VITE_MIN_LANDMARKS=4


# ─────────────────────────────────────────────────────────────────────────────
# 9.12 Compose infrastructure (UNPREFIXED — upstream images own these)
# ─────────────────────────────────────────────────────────────────────────────
#
# These are the only unprefixed variables in the system. They are read by the
# postgres/redis images and by the compose files themselves, not by our code.
#

#   db service
# POSTGRES_USER=landexplorer

#   db service — CHANGE IN PROD
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# POSTGRES_PASSWORD=landexplorer

#   db service
# POSTGRES_DB=landexplorer

#   compose
# POSTGRES_PORT=5432

#   compose
# REDIS_PORT=6379

#   compose (nginx publish)
# LE_WEB_PORT=8080

#   compose.prod
# LE_WORKER_CV_REPLICAS=1

#   compose.prod
# LE_WORKER_IO_REPLICAS=1

#   compose.prod
# LE_WORKER_EXPORT_REPLICAS=1
