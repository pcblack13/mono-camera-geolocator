# ═══════════════════════════════════════════════════════════════════════════════
#  LandExplorer — example environment
#
#  ★ GENERATED FILE. DO NOT EDIT BY HAND.
#      regenerate:  make check-env      (scripts/check_env.py --emit-example)
#      CI compares the generated bytes against this file (CONTRACT.md §13.4 r11).
#      Its source of truth is CONTRACT.md §9.
#
#  ★ COPYING THIS FILE IS OPTIONAL. Every line is commented out, so
#         cp .env.example .env
#    is byte-equivalent to an EMPTY .env. That is not laziness — it is L10 made
#    physical: EVERY SETTING HAS A WORKING DEFAULT, and `Settings()` with an empty
#    environment never raises. Uncomment only what you actually want to change.
#
#  ★ `docker compose up` WITH NO .env AT ALL YIELDS A WORKING APP. It resolves to
#    the KEYLESS Esri World Imagery provider (L2). No account, no key, no card.
#
#  ★ Lines marked  [secret]  are never logged, never returned by any API, and are
#    redacted in /health/ready. They are emitted here with EMPTY values on purpose:
#    a generated example file must never be able to leak or pin a live credential.
#
#  ★ ON A BARE HOST (no compose) the one variable you are most likely to need is
#    LE_DATABASE_URL — its default hostname `db` only resolves inside compose.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# 9.1 Core
# ─────────────────────────────────────────────────────────────────────────────

#   core.config — development|staging|production
# LE_ENV=development

#   core.config, main — forced false when LE_ENV=production
# LE_DEBUG=false

#   OpenAPI title
# LE_APP_NAME=LandExplorer

#   api.v1.router, nginx
# LE_API_PREFIX=/api/v1

#   entrypoint
# LE_API_HOST=0.0.0.0

#   entrypoint, compose
# LE_API_PORT=8000

#   entrypoint
# LE_API_WORKERS=2

#   main (CSV)
# LE_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

#   core.logging
# LE_LOG_LEVEL=INFO

#   core.logging — json|console
# LE_LOG_FORMAT=json

#   api.middleware
# LE_REQUEST_ID_HEADER=X-Request-ID

#   core.security — safe to leave unset BECAUSE AUTH IS OFF BY DEFAULT
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
#   default: ephemeral random per boot
# LE_SECRET_KEY=

#   core.config — set by conftest; enables fixture provider + eager Celery
# LE_TESTING=false

#   main — an internal survey tool benefits more from discoverable docs than it
#   loses to disclosure
# LE_ENABLE_DOCS=true

#   api.deps — 403 READ_ONLY_MODE on every mutating route
# LE_READ_ONLY=false


# ─────────────────────────────────────────────────────────────────────────────
# 9.2 Auth (OFF by default)
# ─────────────────────────────────────────────────────────────────────────────
#
# The honest consequence: with LE_AUTH_MODE=none, gcps.adjusted_by = 'anonymous'.
# The database can prove THAT a coordinate was adjusted and WHEN, but not BY WHOM.
# Acceptable for a single-surveyor deployment; NOT acceptable for a multi-user one
# producing legal survey deliverables. PATCH /gcps/{id} returns 401 the moment
# LE_AUTH_MODE != none and no principal resolves — the audit trail is enforced as
# soon as there is more than one person who could be lying.
#

#   core.security — none|api_key|bearer|cookie
# LE_AUTH_MODE=none

#   core.security
# LE_ACCESS_TOKEN_TTL_SECONDS=3600

#   core.security — CSV of hashed keys
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_API_KEYS=

#   core.security
# LE_JWKS_URL=

#   api.middleware
# LE_RATE_LIMIT_ENABLED=false

#   api.middleware
# LE_RATE_LIMIT_PER_MINUTE=600


# ─────────────────────────────────────────────────────────────────────────────
# 9.3 Database
# ─────────────────────────────────────────────────────────────────────────────
#
# 'db' resolves INSIDE compose. ON A BARE HOST YOU MUST SET LE_DATABASE_URL.
# Deliberate trade: optimise the default for the documented happy path (compose)
# and make the bare-host failure legible via /health/ready's per-dependency
# diagnosis rather than a boot traceback.
#

#   db.session, alembic/env
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_DATABASE_URL=postgresql+psycopg://landexplorer:landexplorer@db:5432/landexplorer

#   alembic/env — a distinct superuser role in prod
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
#   default: = LE_DATABASE_URL
# LE_MIGRATION_DATABASE_URL=

#   db.session
# LE_DB_POOL_SIZE=5

#   db.session
# LE_DB_MAX_OVERFLOW=10

#   db.session
# LE_DB_POOL_TIMEOUT_SECONDS=30

#   db.session
# LE_DB_ECHO=false

#   db.session
# LE_DB_STATEMENT_TIMEOUT_MS=30000

#   entrypoints/api.sh — compose.dev sets true; PROD LEAVES IT false
# LE_DB_AUTO_MIGRATE=false


# ─────────────────────────────────────────────────────────────────────────────
# 9.4 Redis / Celery
# ─────────────────────────────────────────────────────────────────────────────

#   tasks.celery_app, health, idempotency, pubsub, rate limit
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_REDIS_URL=redis://redis:6379/0

#   tasks.celery_app
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
#   default: = LE_REDIS_URL
# LE_CELERY_BROKER_URL=

#   tasks.celery_app
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_CELERY_RESULT_BACKEND=redis://redis:6379/1

#   tasks.celery_app — tests set true
# LE_CELERY_TASK_ALWAYS_EAGER=false

#   worker entrypoint — CV queue. Keep low: SIFT is CPU-hungry.
# LE_CELERY_WORKER_CONCURRENCY=2

#   tasks.base — soft => catchable => job marked failed cleanly
# LE_CELERY_TASK_SOFT_TIME_LIMIT=600

#   tasks.celery_app — hard kill
# LE_CELERY_TASK_TIME_LIMIT=900

#   long tasks => no hoarding
# LE_CELERY_PREFETCH_MULTIPLIER=1

#   redelivery on worker crash
# LE_CELERY_ACKS_LATE=true

#   tasks.base
# LE_JOB_MAX_ATTEMPTS=3

#   tasks.base
# LE_JOB_RETRY_BACKOFF_SECONDS=5

#   tasks.base
# LE_JOB_RETRY_BACKOFF_MAX_SECONDS=120

#   tasks.celery_app
# LE_JOB_RESULT_TTL_SECONDS=86400

#   tasks.maintenance — reaper marks orphaned running => failed
# LE_JOB_STALE_AFTER_SECONDS=1800

#   tasks.progress
# LE_JOB_PROGRESS_TTL_SECONDS=3600

#   tasks.maintenance
# LE_JOB_RETENTION_DAYS=30


# ─────────────────────────────────────────────────────────────────────────────
# 9.5 Storage & uploads
# ─────────────────────────────────────────────────────────────────────────────

#   storage — local|s3
# LE_STORAGE_BACKEND=local

#   storage.local — MUST BE A SHARED VOLUME ACROSS api + workers
# LE_STORAGE_LOCAL_ROOT=./data/storage

#   storage.s3
# LE_STORAGE_S3_BUCKET=

#   storage.s3 — set for MinIO
# LE_STORAGE_S3_ENDPOINT_URL=

#   storage.s3
# LE_STORAGE_S3_REGION=us-east-1

#   storage.s3
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_STORAGE_S3_ACCESS_KEY_ID=

#   storage.s3
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_STORAGE_S3_SECRET_ACCESS_KEY=

#   storage.s3
# LE_STORAGE_SIGNED_URL_TTL_SECONDS=900

#   image_service — 507 INSUFFICIENT_STORAGE, checked BEFORE streaming
# LE_STORAGE_MIN_FREE_BYTES=2147483648

#   api.middleware, nginx — 500 MB. MIRROR IN nginx client_max_body_size.
# LE_UPLOAD_MAX_BYTES=524288000

#   image_service — SNIFFED, not trusted from the header
# LE_UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/tiff,image/webp

#   image_service — decompression-bomb guard
# LE_MAX_IMAGE_PIXELS=400000000

#   image_service
# LE_MAX_IMAGE_DIM=65535

#   image_service — above this, ingest goes async
# LE_ASYNC_INGEST_THRESHOLD_BYTES=52428800

#   images.py — X-Accel-Redirect in prod
# LE_USE_SENDFILE=false


# ─────────────────────────────────────────────────────────────────────────────
# 9.6 Imagery
# ─────────────────────────────────────────────────────────────────────────────
#
# L2: THE DEFAULT PROVIDER IS KEYLESS. Everything in this section is opt-in
# EXCEPT esri_world_imagery, which needs no key and is what `docker compose up`
# with an empty .env resolves to.
#
# ESRI ToS: the World Imagery basemap is served by Esri under the ArcGIS Online
# terms. ATTRIBUTION IS MANDATORY on screen and on derived output
# (LE_EXPORT_INCLUDE_ATTRIBUTION — leave it true). Review the terms for your
# own use case before deploying; see docs/legal/imagery-terms.md.
#
# GOOGLE EARTH IS NOT A PROVIDER AND NEVER WILL BE. Not a disabled flag: an
# absence. There is no enum label for it, no scaffolding, and CI greps for Earth
# endpoint patterns. LE_GOOGLE_MAPS_STATIC_KEY below is the Maps *Static API*,
# a different product with different terms, and it is double-opt-in.
#

#   gis.imagery.registry — 'auto' walks LE_IMAGERY_FALLBACK_CHAIN and takes the
#   first is_configured() provider. An explicit name uses that provider, with
#   the chain as error-recovery only.
# LE_IMAGERY_PROVIDER=auto

#   gis.imagery.registry — local_orthophoto FIRST: if the operator mounted
#   orthophotos they are definitionally better than any web tile source. It
#   self-skips via is_configured() when the dir is empty, so the zero-config
#   machine lands on Esri with no branching.
# LE_IMAGERY_FALLBACK_CHAIN=local_orthophoto,esri_world_imagery

#   imagery_service — false => tile_url_template is the PROXY PATH for every
#   provider, preserving the ToS chokepoint, the shared quota bucket and
#   worker/browser cache identity. true => keyless providers return their
#   upstream URL; the ToS consequence is in docs/legal/imagery-terms.md.
# LE_IMAGERY_DIRECT_TILE_URLS=false

#   gis.imagery.registry — true in prod: no silent fallback
# LE_IMAGERY_STRICT=false

#   gis.imagery.registry — the operator's hard allow-list. Empty = all
#   registered.
# LE_ALLOWED_PROVIDERS=

#   registry — true => only local_orthophoto + fixture. See
#   docs/guides/offline-mode.md and `make seed`.
# LE_IMAGERY_OFFLINE=false

#   gis.imagery.cache — memory|disk|redis. REDIS IN PROD: tile fetching happens
#   inside Celery workers and a disk cache in a container is per-replica; four
#   workers searching the same AOI would fetch every tile four times.
# LE_IMAGERY_TILE_CACHE_BACKEND=disk

#   cache.disk
# LE_IMAGERY_TILE_CACHE_DIR=./data/tile_cache

#   cache — 30 d. SEVERAL ToS CAP CACHING; see docs/legal/imagery-terms.md.
# LE_IMAGERY_TILE_CACHE_TTL_SECONDS=2592000

#   tasks.maintenance — 20 GB LRU cap
# LE_IMAGERY_TILE_CACHE_MAX_BYTES=21474836480

#   gis.imagery.http
# LE_IMAGERY_MAX_CONCURRENT_FETCHES=4

#   gis.imagery.ratelimit — token bucket per provider
# LE_IMAGERY_RATE_LIMIT_RPS=5

#   gis.imagery.http
# LE_IMAGERY_REQUEST_TIMEOUT_SECONDS=15

#   gis.imagery.http — jittered backoff
# LE_IMAGERY_MAX_RETRIES=3

#   gis.imagery.http — OPERATORS SHOULD SET A REAL CONTACT
# LE_IMAGERY_USER_AGENT=LandExplorer/1.0 (+https://example.invalid)

#   providers.esri — NOTE THE {z}/{y}/{x} ORDER. kind=satellite.
# LE_ESRI_IMAGERY_TILE_URL_TEMPLATE=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

#   providers.esri — the overlay composited OVER imagery to serve kind=hybrid
# LE_ESRI_REFERENCE_TILE_URL_TEMPLATE=https://services.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}

#   providers.esri — kind=terrain
# LE_ESRI_TERRAIN_TILE_URL_TEMPLATE=https://services.arcgisonline.com/ArcGIS/rest/services/World_Terrain_Base/MapServer/tile/{z}/{y}/{x}

#   providers.esri
# LE_ESRI_MAX_ZOOM=19

#   providers.esri
# LE_ESRI_RATE_LIMIT_RPS=8.0

#   providers.local_ortho — empty dir => provider reports unavailable, NO CRASH
# LE_LOCAL_ORTHO_DIR=./data/orthophotos

#   providers.local_ortho
# LE_LOCAL_ORTHO_ATTRIBUTION=Local orthophoto

#   providers.local_ortho
# LE_LOCAL_ORTHO_REINDEX_SECONDS=300

#   FALSE ON PURPOSE — black is a legitimate pixel value
# LE_LOCAL_ORTHO_ASSUME_BLACK_NODATA=false

#   providers.mapbox — empty => NOT OFFERED, not a crash
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_MAPBOX_ACCESS_TOKEN=

#   providers.mapbox
# LE_MAPBOX_STYLE_ID=mapbox.satellite

#   VERIFY AGAINST CURRENT ToS
# LE_MAPBOX_CACHE_TTL_SECONDS=2592000

#   providers.bing
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_BING_MAPS_KEY=

#   providers.bing
# LE_BING_IMAGERY_SET=Aerial

#   providers.sentinel
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_COPERNICUS_CLIENT_ID=

#   providers.sentinel
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_COPERNICUS_CLIENT_SECRET=

#   providers.sentinel — ★ REQUIRED alongside the two credentials above: the WMTS
#   endpoint is per-configuration, and is_configured() is False without it. From the
#   Sentinel Hub Configuration Utility at dataspace.copernicus.eu.
# LE_COPERNICUS_INSTANCE_ID=

#   providers.sentinel
# LE_COPERNICUS_MAX_CLOUD_PCT=20

#   providers.sentinel — REFUSES zoom > 15 rather than serving upsampled mush a
#   matcher would confidently act on
# LE_SENTINEL_MAX_ZOOM=15

#   providers.google_static
#   [secret] never logged · never returned by any API · redacted in
#            /health/ready. Set this via a real secret store in prod.
# LE_GOOGLE_MAPS_STATIC_KEY=

#   providers.google_static — DOUBLE OPT-IN. The key alone is insufficient; the
#   operator must assert their own ToS coverage. Google EARTH is never a
#   provider.
# LE_GOOGLE_TOS_ACKNOWLEDGED=false


# ─────────────────────────────────────────────────────────────────────────────
# 9.6a Elevation
# ─────────────────────────────────────────────────────────────────────────────

#   gis.elevation — none|local_dem|copernicus_dem. 'none' is KEYLESS, OFFLINE
#   and TERMINAL: elevation_m and elevation_source are both NULL and the job
#   says ELEVATION_UNAVAILABLE. Honest beats absent.
# LE_ELEVATION_PROVIDER=none

#   elevation.local_dem — empty dir => unavailable, NO CRASH
# LE_LOCAL_DEM_DIR=./data/dem

#   elevation.copernicus_dem
# LE_COPERNICUS_DEM_URL=

#   elevation
# LE_ELEVATION_CACHE_TTL_SECONDS=2592000


# ─────────────────────────────────────────────────────────────────────────────
# 9.7 Search
# ─────────────────────────────────────────────────────────────────────────────
#
# LE_SEARCH_REQUIRE_PRIOR IS DELETED. The requirement is unconditional: a hint is
# a hard input requirement, not a toggle. 422 SEARCH_HINT_REQUIRED, always. A config
# flag implying global search is possible would be a lie.
#

#   candidates.strategy
# LE_SEARCH_DEFAULT_ZOOM=18

#   candidates.hint
# LE_SEARCH_DEFAULT_RADIUS_M=1000

#   matching.py validation
# LE_SEARCH_MAX_RADIUS_M=50000

#   candidates.strategy
# LE_SEARCH_MAX_CANDIDATES=25

#   candidates.strategy
# LE_SEARCH_WINDOW_SIZE_PX=1024

#   candidates.strategy — buys the 512 px footprint guarantee. At 0.25 the
#   guarantee is only 256 px, and the matching design reasons from 512.
# LE_SEARCH_OVERLAP_RATIO=0.5

#   candidates.strategy
# LE_SEARCH_TARGET_GSD_M=0.5

#   candidates.budget
# LE_MAX_TILES_PER_JOB=512

#   imagery.py — endpoint 53 is a request, not a job
# LE_MAX_STATIC_TILES=16

#   imagery.py — 4 MP. A 64-megapixel stitch inside a GET is the workload L5
#   forbids.
# LE_MAX_STATIC_PIXELS=4194304

#   matching.py validation
# LE_SEARCH_MAX_BBOX_AREA_KM2=2500

#   candidates.hint — multiply EXIF HPE
# LE_EXIF_RADIUS_INFLATION=3.0

#   candidates.hint
# LE_EXIF_MIN_RADIUS_M=250


# ─────────────────────────────────────────────────────────────────────────────
# 9.8 AI engine
# ─────────────────────────────────────────────────────────────────────────────
#
# ★ READ docs/architecture/SCOPE.md BEFORE TUNING ANYTHING IN THIS SECTION.
#   THE AUTOMATIC MATCHING ENGINE IS DEFERRED IN THIS BUILD. Feature extraction,
#   matching, RANSAC, homography, pose, heatmap, semantics and scoring exist as
#   typed stubs that raise NotImplementedDeferred; the endpoints that would drive
#   them return 501. THESE VARIABLES ARE THE CONFIG SURFACE OF A DEFERRED ENGINE.
#   Setting them changes nothing observable today. They are kept — with their
#   contract defaults — so that re-enabling the engine requires zero changes
#   outside ai_engine/ (SCOPE.md §7).
#
#   GCPs in this build are placed MANUALLY: the surveyor marks a landmark in the
#   photo and clicks the same spot on the map. The coordinate is a DIRECT
#   OBSERVATION, and `confidence` is SURVEYOR-DECLARED — never computed. No value
#   below can change that, including LE_AI_MIN_CONFIDENCE.
#

#   match_service -> AiEngineConfig — L1 default
# LE_AI_EXTRACTOR=sift

#   -> AiEngineConfig
# LE_AI_MATCHER=flann

#   -> AiEngineConfig — empty => no LoFTR
# LE_AI_DETECTOR_FREE=

#   -> AiEngineConfig.segmenter
# LE_AI_SEGMENTER=classical

#   -> AiEngineConfig.suggester
# LE_AI_SUGGESTER=classical_suggester

#   -> AiEngineConfig.ransac.method: HomographyMethod. A ROBUST-FIT METHOD.
# LE_AI_RANSAC_METHOD=usac_magsac

#   -> AiEngineConfig.estimator_backend. A COMPONENT REGISTRY KEY. 'opencv' is
#   the only registered one. (LE_AI_ESTIMATOR is DELETED — it conflated the two
#   and was a zero-env boot crash.)
# LE_AI_ESTIMATOR_BACKEND=opencv

#   registry — true = ATTEMPT deep backends; unavailability is still graceful.
#   false = never even probe.
# LE_AI_ALLOW_DEEP_MODELS=true

#   models.policy — true => missing weights RAISE instead of falling back. CI
#   accuracy suites only. true IN PROD VIOLATES L1.
# LE_AI_STRICT_BACKEND=false

#   models.weights — EMPTY BY DEFAULT AND THAT IS THE SUPPORTED STATE
# LE_AI_MODEL_WEIGHTS_DIR=./data/model_weights

#   models.device — 'auto' -> cpu on this machine (cuda.is_available() is False
#   despite the cu130 wheel). 'cuda' when unavailable => WARN + cpu.
# LE_AI_DEVICE=auto

#   models.device — 0 = leave torch's default
# LE_AI_TORCH_THREADS=0

#   pipeline — RANSAC reproducibility
# LE_AI_DETERMINISTIC_SEED=42

#   extractors
# LE_AI_MAX_FEATURES=8000

#   extractors.preprocess — big win on hazy field photos
# LE_AI_CLAHE_ENABLED=true

#   matchers.filters — Lowe
# LE_AI_RATIO_TEST=0.75

#   matchers — mutual NN
# LE_AI_CROSS_CHECK=true

#   matchers — below => candidate skipped
# LE_AI_MIN_MATCHES=10

#   geometry
# LE_AI_RANSAC_THRESHOLD_PX=3.0

#   geometry
# LE_AI_RANSAC_MAX_ITERS=10000

#   geometry
# LE_AI_RANSAC_CONFIDENCE=0.999

#   geometry.degeneracy — H1
# LE_AI_MIN_INLIERS=12

#   pipeline.ranking — 0-100. Below => candidate dropped. REFUSING TO ANSWER
#   BEATS A CONFIDENT WRONG COORDINATE (L12).
# LE_AI_MIN_CONFIDENCE=40.0

#   pipeline.ranking — 0-100. Winner must beat runner-up by this, else
#   status="ambiguous"
# LE_AI_RANK_MARGIN=10.0

#   pipeline — ranked candidates persisted
# LE_AI_MAX_RESULTS=5

#   scoring.composite
# LE_AI_SCORE_WEIGHT_FEATURE=0.25

#   scoring.composite
# LE_AI_SCORE_WEIGHT_GEOMETRIC=0.35

#   scoring.composite
# LE_AI_SCORE_WEIGHT_LANDMARK=0.30

#   scoring.composite
# LE_AI_SCORE_WEIGHT_SEMANTIC=0.10

#   scoring.calibration — SHIPS UNCALIBRATED AND SAYS SO
# LE_AI_CALIBRATION_ID=identity

#   semantics — off: SAM is heavy and weight-dependent
# LE_AI_SEMANTICS_ENABLED=false

#   CODE-ENFORCED cap. CPU-only reality.
# LE_AI_DEEP_MAX_CANDIDATES=8

#   semantics.sam — empty => classical masks
# LE_AI_SAM_CHECKPOINT=

#   extractors.superpoint
# LE_AI_SUPERPOINT_WEIGHTS=

#   matchers.superglue
# LE_AI_SUPERGLUE_WEIGHTS=

#   matchers.lightglue
# LE_AI_LIGHTGLUE_WEIGHTS=

#   matchers.loftr
# LE_AI_LOFTR_WEIGHTS=

#   extractors.dinov2
# LE_AI_DINOV2_WEIGHTS=


