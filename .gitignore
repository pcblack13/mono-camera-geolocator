# ═══════════════════════════════════════════════════════════════════════════════
#  LandExplorer — .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Secrets ──────────────────────────────────────────────────────────────────
# ★ .env is IGNORED; .env.example is COMMITTED (and generated — §13.4 r11).
#   Copying the example is optional: every line in it is commented out, so an
#   absent .env and a copied one are the same thing (L10).
.env
.env.*
!.env.example
*.pem
*.key
!**/py.typed

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtualenvs
# ★ scripts/bootstrap_dev.sh creates .venv with --system-site-packages, WITHOUT
#   which cv2/numpy/scipy/torch/osgeo are invisible and osgeo cannot be
#   pip-installed back (§0.1).
.venv/
venv/
ENV/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/
.cache/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
frontend/dist/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# ★ pnpm-lock.yaml IS committed (§2.5 mandates it). Never ignore a lockfile.

# ── data/ — §2.10: gitignored except .gitkeep ────────────────────────────────
#   Runtime artefacts. Ignored WHOLESALE and then re-included by exception, so a
#   new subdirectory is ignored by default rather than accidentally committed.
#   A surveyor's uploaded field photos must never end up in git.
data/*
!data/.gitkeep
!data/storage/
data/storage/*
!data/storage/.gitkeep
!data/tile_cache/
data/tile_cache/*
!data/tile_cache/.gitkeep
!data/model_weights/
data/model_weights/*
!data/model_weights/.gitkeep
!data/orthophotos/
data/orthophotos/*
!data/orthophotos/.gitkeep
!data/dem/
data/dem/*
!data/dem/.gitkeep
!data/fixtures/
data/fixtures/*
!data/fixtures/.gitkeep

# ★ Model weights are NEVER committed. Multi-gigabyte binaries with licences that
#   are frequently NOT the code's licence (SuperGlue is non-commercial). They are
#   fetched opt-in via scripts/download_models.py, which prints the licence and
#   requires --accept-license. §9.8: the weights dir is EMPTY by default and that
#   is the supported state.
*.pth
*.ckpt
*.onnx
*.safetensors
*.pt
*.bin
!**/fixtures/**/*.bin

# ── Committed fixtures — the exception that matters ──────────────────────────
# ★ The rules below re-include the fixtures §13.2 REQUIRES to be committed. They
#   are what make the coordinate math verifiable with no network, no weights and
#   no GPU, and they cost < 500 KB. Generated by scripts/make_fixtures.py.
!gis/src/gis/tests/fixtures/**
!ai_engine/src/ai_engine/tests/fixtures/**
!tests/fixtures/**

# ── Editors / OS ─────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & scratch ───────────────────────────────────────────────────────────
*.log
logs/
tmp/
.tmp/
*.pid
celerybeat-schedule*
celerybeat.pid

# ── Local overrides ──────────────────────────────────────────────────────────
docker-compose.override.yml
.claude/settings.local.json


/raw.zip
/raw

# ── Runtime data (uploads, exports, cached tiles) — regenerated by the app, never in VCS ──
/backend/data/
/exporttesting/

# ── DTM_Proccesing/ — the source algorithm, ported into gis/dem ───────────────
# ★ The SOURCE SCRIPTS AND READMEs ARE COMMITTED (~68 KB): they are the provenance
#   of gis/dem's three stages, and worth keeping beside the port.
#   Everything heavy is NOT: a vendored Windows venv (265 MB), the Copernicus and
#   FABDEM source tiles (40 MB each), processed outputs, and a >50 MB dem.tif that
#   GitHub would reject outright. Rasters are DATA — same rule as data/ above:
#   regenerated or re-downloaded, never in VCS.
DTM_Proccesing/**/venv/
DTM_Proccesing/**/*.tif
DTM_Proccesing/**/*.tif.aux.xml
DTM_Proccesing/*.tif
DTM_Proccesing/**/output/
# Field survey data (camera stations with GPS) — the surveyor's own records, and
# the same reason data/ keeps uploaded photographs out of git.
DTM_Proccesing/**/*.xlsx
DTM_Proccesing/**/*.csv
DTM_Proccesing/**/.claude/

# ── Claude Code config + graphify cache ──────────────────────────────────────
# ★ Was `/claude` — missing the DOT, so it matched nothing. And a leading slash
#   pins to this repo's root; `.claude/` covers any level.
.claude/
graphify-out/

PROMPT.TXT

# ── desktop build artifacts ──────────────────────────────────────────────────
# ★ `runtime-build/*` NOT `runtime-build/` — a trailing-slash directory pattern
#   makes git skip the whole tree, so the negation below could never resurface
#   the build SCRIPT, and a fresh clone had no way to build the runtime at all.
#   The artifacts (micromamba, the conda env, runtime.tar.gz — gigabytes) stay
#   ignored; the ~1 KB recipe that recreates them is source and is tracked.
# ★ dist-installers/ stays FULLY ignored: the installers are 400+ MB each and
#   GitHub rejects any file over 100 MB. They are built from the repo
#   (`desktop/install-from-source.sh`), never committed.
desktop/runtime-build/*
!desktop/runtime-build/build-runtime.sh
!desktop/runtime-build/build-runtime.ps1
desktop/dist-installers/
# run-desktop.sh's staged resources dir — three symlinks into the checkout.
desktop/local-resources/
# ★ The generic Python `build/` rule above also swallowed desktop/build/ — which is
#   CONFIG, not output: it holds electron-builder's deb postinst (the SUID-sandbox
#   fix installers need on Ubuntu ≥ 24.04). The DIRECTORY is re-included (a file
#   negation cannot pierce an ignored directory).
!desktop/build/

# Sidecar pidfile — written beside the API cwd so the next boot can reap orphans
sidecars.lastpids
